{
  "name": "vault-talk",
	"version": "1.5.0",
  "description": "First-class Cursor in Obsidian. The desk is today's note. Jarvis uses your Cursor models and writes the vault.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "vault-talk",
    "grok",
    "voice",
    "tts"
  ],
  "author": "Jonas Wolber",
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "1.10.0",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@connectrpc/connect": "1.6.1",
    "@connectrpc/connect-node": "1.6.1",
    "@connectrpc/connect-web": "1.6.1",
    "@statsig/js-client": "3.31.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
