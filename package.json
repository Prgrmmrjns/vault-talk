{
  "name": "vault-talk",
	"version": "1.4.2",
  "description": "Vault Talk — Jarvis in Obsidian. Speak or type with Grok Voice; optionally edit markdown notes.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "vault-talk",
    "grok",
    "voice",
    "tts"
  ],
  "author": "Jonas Wolber",
  "license": "MIT",
  "dependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@cursor/sdk": "^1.0.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
