{
  "name": "vault-talk",
  "version": "1.5.1",
  "description": "First-class Cursor chat. The desk is today's note. Jarvis uses your Cursor models and can edit notes.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "vault-talk",
    "grok",
    "voice",
    "tts"
  ],
  "author": "Jonas Wolber",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
